<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/status_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/status_ripple_rounded">

        <ImageView
            android:id="@+id/status_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/monitor_linear_gray" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Offline"
            android:textSize="10sp"
            android:textColor="#5D5D5D"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btn_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/previous_filled"
            android:background="@drawable/button_ripple_rounded"
            android:padding="6dp"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/btn_play"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/pause_filled"
            android:background="@drawable/button_ripple_rounded"
            android:padding="6dp"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/btn_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/next_filled"
            android:background="@drawable/button_ripple_rounded"
            android:padding="6dp"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/btn_mute"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/volume_slash_filled"
            android:background="@drawable/button_ripple_rounded"
            android:padding="6dp"
            android:scaleType="fitCenter" />

        <Button
            android:id="@+id/btn_vol_down"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="−"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:background="@drawable/button_ripple_rounded"
            android:gravity="center" />

        <Button
            android:id="@+id/btn_vol_up"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="+"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:background="@drawable/button_ripple_rounded"
            android:gravity="center" />

    </LinearLayout>

</RelativeLayout>